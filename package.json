
{
  "name": "nonlinear-animation-site",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=nonlinear-animation-site",
    "deploy:worker": "wrangler deploy",
    "deploy:all": "npm run deploy && npm run deploy:worker",
    "worker:dev": "wrangler dev",
    "dev:full": "concurrently \"npm run dev\" \"npm run worker:dev\""
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "concurrently": "^8.2.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "wrangler": "^3.90.0"
  }
}